{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "repo-manager",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "GITHUB_OWNER": "marufhossainkeyas11",
    "GITHUB_REPO": "repo-manager",
    "GITHUB_BRANCH": "main"
  },
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "9869ae2e17b54fad86f7da17be7274d3"
    },
    {
      "binding": "CONFIG",
      "id": "42ca553022494f55a30e807f0fe899d2"
    }
  ]
}

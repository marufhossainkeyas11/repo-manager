{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "repo-manager",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "GITHUB_OWNER": "marufhossainkeyas11",
    "GITHUB_REPO": "Ip",
    "GITHUB_BRANCH": "main"
  }
}
